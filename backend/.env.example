# --- Database (PostgreSQL) ----------------------------------------------
# Local development: start the database with
#   docker compose -f docker-compose.dev.yml up -d     (from the repo root)
DB_HOST=localhost
DB_PORT=5432
DB_USER=sportprogression
DB_PASS=sportprogression
DB_NAME=sportprogression
DB_SSL=false
# With DB_SSL=true: set to false to accept a self signed certificate.
#DB_SSL_REJECT_UNAUTHORIZED=true

# Schema changes are migrations (src/database/migrations), applied when the
# API starts. Set to false to run them yourself (npm run migration:run).
#DB_MIGRATIONS_RUN=true
# Rewrite the tables to match the code instead of using migrations. Only for a
# throwaway database: it can drop columns and their data.
#DB_SYNCHRONIZE=false
# Print every SQL statement (includes user data). Off unless set to true.
#DB_LOGGING=false

# --- Deployment ---------------------------------------------------------
# Port the API listens on (default 3001; the frontend dev server uses 4201).
#PORT=3001
# Number of reverse-proxy hops in front of the API (e.g. 1 behind nginx or a
# platform load balancer), so rate limiting sees the real client address.
#TRUST_PROXY=1

# --- Auth ---------------------------------------------------------------
# Passwordless demo login. Only works with NODE_ENV=development AND a
# database on this machine (DB_HOST localhost), so it can never be switched
# on against a real database.
DEV_LOGIN=true

GOOGLE_CLIENT_ID=xxxx
GOOGLE_CLIENT_SECRET=xxxx
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

JWT_SECRET=super-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-token-key
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:4201

NODE_ENV=development

# --- AI analysis --------------------------------------------------------
# Claude API key (https://platform.claude.com) for the "Analyse" buttons.
# Server-side only: it is never sent to the browser. Leave empty to keep the
# feature switched off. Every analysis is a paid API call.
ANTHROPIC_API_KEY=
# The "AI" role. Only these accounts (comma-separated e-mail addresses) may use
# the analysis and plan features, so nobody else can spend your API credit.
# "*" lets every signed-in user in. Leave empty to switch AI off for everyone
# who does not have the role in the database (users.aiAccess).
AI_ALLOWED_EMAILS=
