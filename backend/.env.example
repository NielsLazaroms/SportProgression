# --- Database -----------------------------------------------------------
# Quick local start (no database server needed): everything is stored in one
# SQLite file. Leave DB_TYPE empty (or "mysql") to use MySQL instead.
DB_TYPE=sqljs
DB_FILE=dev-data.sqlite

# MySQL (used when DB_TYPE is not "sqljs")
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
DB_SSL=false

# Let the app rewrite the database tables to match the code on startup.
# Defaults to on in development and OFF in production (it can drop columns and
# their data). After deploying a version that changes the schema, back up and
# run once with DB_SYNCHRONIZE=true.
#DB_SYNCHRONIZE=false
# Print every SQL statement (includes user data). Off unless set to true.
#DB_LOGGING=false

# --- Deployment ---------------------------------------------------------
# Number of reverse-proxy hops in front of the API (e.g. 1 behind nginx or a
# platform load balancer), so rate limiting sees the real client address.
#TRUST_PROXY=1

# --- Auth ---------------------------------------------------------------
# Passwordless demo login. Only works with NODE_ENV=development AND
# DB_TYPE=sqljs, so it can never be switched on against a real database.
DEV_LOGIN=true

GOOGLE_CLIENT_ID=xxxx
GOOGLE_CLIENT_SECRET=xxxx
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

JWT_SECRET=super-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-token-key
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:4200

NODE_ENV=development
